# Copy this file to .env.local for local development. Never commit .env.local.
# The defaults below match the existing local phpMyAdmin/MySQL setup.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=akbar_ecommerce
DB_USER=root
DB_PASSWORD=
DB_SSL=false
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Required for customer registration/sign-in OTPs, order confirmations, and the Contact form.
# Use real values only in .env.local or the deployment secret manager.
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=your-mailbox@example.com
SMTP_PASSWORD=replace-with-your-mailbox-password
SMTP_FROM=your-mailbox@example.com

# Optional integrations
# N-Genius Online sandbox: create an account at https://www.network.ae/en/test-account
# PAYMENT_PROVIDER=ngenius
# NGENIUS_ENVIRONMENT=sandbox
# NGENIUS_API_KEY=
# NGENIUS_OUTLET_REFERENCE=
# NGENIUS_WEBHOOK_HEADER_NAME=X-Webhook-Secret
# NGENIUS_WEBHOOK_SECRET=
# SEED_DEMO_DATA=false
